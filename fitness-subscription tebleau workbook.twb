      <column caption='Acquisition Channel' datatype='string' name='[Acquisition_Channel]' role='dimension' type='nominal' />
      <column caption='Firts Puerchase Date' datatype='date' datatype-customized='true' name='[Calculation_2951068467208192]' role='dimension' type='quantitative'>
