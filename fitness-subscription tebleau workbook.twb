      </column>
      <column caption='Cohort Month' datatype='datetime' name='[Calculation_2951068470644737]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[Calculation_2951068467208192])' />
      </column>
      <column caption='Months Since First Purchase' datatype='integer' name='[Calculation_2951068471517186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Calculation_2951068467208192],[Transaction_Date])' />
